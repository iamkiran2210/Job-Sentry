# Application
APP_NAME="Job Sentry"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Database & Redis
DATABASE_URL=postgresql+asyncpg://kiran:Kiran123@localhost:5432/kiran
REDIS_URL=redis://localhost:6379/0

# JWT Security
JWT_SECRET=replace-with-a-very-secure-random-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# CORS
ALLOWED_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Configuration
AI_ENV=development
AI_ENGINE=auto
AI_MODEL=heuristic
AI_FAST_MODEL=
AI_NANO_MODEL=
AI_FALLBACK_MODELS=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_SECONDS=90
AI_MAX_TOKENS=8192
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=86400
AI_REASONING_EFFORT_EXTRACTION=low
AI_REASONING_EFFORT_REASONING=low
AI_USE_COMPILED=true
AI_REQUIREMENTS_PROVIDER=app.ai_features.ai.requirements:build_provider

# External Verification (Bright Data LinkedIn SDK & GitHub)
BRIGHT_DATA_API_KEY=
GITHUB_TOKEN=

# Optional LangSmith Tracing & Sentry Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-sentry
SENTRY_DSN=

# SendPulse Email API (Bearer API Key — no OAuth; uses Audit Outbox when SENDPULSE_API_KEY is unset)
# On new accounts (SMTP Test plan), devtest@sendpulseemail.com is pre-verified out of the box.
# On Free/paid plans, replace with your own verified sender email.
SENDPULSE_API_KEY=your-sendpulse-api-key
SENDPULSE_API_FROM_EMAIL=devtest@sendpulseemail.com
SENDPULSE_API_FROM_NAME="Job Sentry"
SENDPULSE_API_BASE_URL=https://api.sendpulse.com

# Resume Ingestion & Celery
RESUMES_STORAGE_BACKEND=local
RESUMES_LOCAL_STORAGE_DIR=./var/resume_storage
RESUMES_CELERY_BROKER_URL=redis://localhost:6379/0
RESUMES_MAX_UPLOAD_BYTES=10485760
RESUMES_MAX_FILES_PER_REQUEST=20
RESUMES_OCR_LANGUAGES=eng
RESUMES_LOG_TRACEBACKS=false
