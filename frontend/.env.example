# Single place to point the app at your FastAPI backend (no trailing slash).
PUBLIC_API_BASE_URL=http://localhost:8000

# Google Sign-In. Must equal the backend GOOGLE_CLIENT_ID. Leave empty to hide the Google button.
PUBLIC_GOOGLE_CLIENT_ID=

# Backend score scale: 100 means scores are 0-100 (default); 1 means 0-1. Also used for min/max score filters.
PUBLIC_SCORE_SCALE=100
